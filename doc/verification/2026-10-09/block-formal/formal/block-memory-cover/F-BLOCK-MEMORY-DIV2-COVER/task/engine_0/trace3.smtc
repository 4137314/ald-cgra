assume (= [clk] false)
assume (= [count] #b00000000000)
assume (= [pe_result] #b0000000000000000)
assume (= [rst] false)
assume (= [start] false)
assume (= [wr_addr] #b0000000000)
assume (= [wr_bank] true)
assume (= [wr_data] #b0000000000000000)
assume (= [wr_en] true)

