initial
assume (= [block_dot_contract.f_known_a] false)
assume (= [block_dot_contract.f_known_b] false)
assume (= [block_dot_contract.f_reset_written] false)
assume (= [block_dot_contract.f_rewritten] false)
assume (= [done] false)
assume (= [guard] #b00)
assume (= [index] #b0000000000)
assume (= [operand_a] #b0000000000000000)
assume (= [operand_b] #b0000000000000000)
assume (= [owned] false)
assume (= [qa] #b0000000000000000)
assume (= [qb] #b0000000000000000)
assume (= [remaining] #b00000000000)
assume (= [result] #b0000000000000000)
assume (= [state] #b000)
assume (= (select [bank_a] #b0000000000) #b0000000000000000)
assume (= (select [bank_b] #b0000000000) #b0000000000000000)

