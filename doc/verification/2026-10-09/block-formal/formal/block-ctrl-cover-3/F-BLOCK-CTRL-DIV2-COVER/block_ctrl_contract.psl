-- Integrated production controller, frame receiver and RAM engine. Initial
-- synchronous reset is supplied by cgra_top's initialized reset synchronizer.
-- Later reset/RX bytes/TX busy/PE result are unrestricted.
vunit block_ctrl_contract (block_ctrl(rtl)) {
  default clock is rising_edge(clk);
  F_SELECTED: assert always (G_STEP_DIV = 2 and G_TIMEOUT_CYCLES = 3);

  signal f_seen : boolean := false;
  signal f_duplicate, f_replayed : boolean := false;
  -- Quantify over every cached byte with one unconstrained constant index.
  signal f_address : unsigned(7 downto 0);
  attribute anyconst : boolean;
  attribute anyconst of f_address : signal is true;
  signal f_old_cache, f_old_response : byte_t;
  signal f_old_length : natural range 0 to BLOCK_RAW := 0;
  signal f_old_body : natural range 11 to 17 := 11;
  signal f_cache_write : boolean := false;
  function watched(x : bytes_t; address : unsigned) return byte_t is
    variable i : natural := to_integer(address);
  begin
    if i <= x'high then return x(i); end if;
    return x"00";
  end function;
  monitor : process(clk)
  begin
    if rising_edge(clk) then
      f_seen <= true;
      f_old_cache <= watched(cached_q, f_address); f_old_response <= watched(cached_response, f_address);
      f_old_length <= cached_length; f_old_body <= cached_body;
      f_cache_write <= rst = '1' or (state = S_FINISH and cache_response);
      if rst = '1' or state = S_IDLE then f_duplicate <= false; f_replayed <= false;
      elsif state = S_CHECK then
        f_duplicate <= active and nonce(q) = session and le16(q(6), q(7)) = le16(cached_q(6), cached_q(7));
      elsif state = S_COMPARE and scan = request_length-1 and q(scan) = cached_q(scan) then
        f_replayed <= true;
      end if;
    end if;
  end process;
  A_BLOCK_INITIAL_RESET: assume always (not f_seen -> rst = '1');
  F_BCTRL_STATE: assert always (state <= S_SEND_WAIT);
  F_BCTRL_LOADED: assert always (loaded(0) <= BLOCK_WORDS and loaded(1) <= BLOCK_WORDS);
  F_BCTRL_COUNT: assert always (dot_count <= BLOCK_WORDS);
  F_BCTRL_UPLOAD_COUNT: assert always (upload_count >= 1 and upload_count <= BLOCK_CHUNK);
  F_BCTRL_UPLOAD_INDEX: assert always (upload_index < upload_count);
  F_BCTRL_UPLOAD_SPACE: assert always (upload_offset + upload_count <= BLOCK_WORDS);
  F_BCTRL_WRITE_ADDRESS: assert always (wr_addr < BLOCK_WORDS);
  F_BCTRL_LENGTH: assert always (request_length = 0 or (request_length >= 12 and request_length <= BLOCK_RAW));
  F_BCTRL_REQUEST: assert always (state = S_CHECK or state = S_COMPARE or state = S_OP -> request_length >= 12 and request_length <= BLOCK_RAW);
  F_BCTRL_COMPARE: assert always (state = S_COMPARE -> scan < request_length and request_length = cached_length);
  F_BCTRL_BODY: assert always (body_length >= 11 and body_length <= 17 and cached_body >= 11 and cached_body <= 17);
  F_BCTRL_CRC_INDEX: assert always (state = S_CRC -> scan <= body_length);
  F_BCTRL_ENCODING: assert always (state = S_ENCODE -> scan <= body_length+1 and wire_length >= 1 and wire_length <= 2*scan+1);
  F_BCTRL_CLOSING: assert always (state = S_CLOSE -> wire_length >= 1 and wire_length <= 2*(body_length+2)+1);
  F_BCTRL_WIRE_SIZE: assert always (wire_length <= 40 and wire_index < 40);
  F_BCTRL_SEND_INDEX: assert always (state = S_SEND or state = S_SEND_WAIT -> wire_index < wire_length);
  F_BCTRL_NO_CONCURRENT_WRITE: assert always (wr_en = '1' -> dot_busy = '0');
  F_BCTRL_DOT_START: assert always (dot_start = '1' -> dot_busy = '0' and dot_count <= loaded(0) and dot_count <= loaded(1));
  F_BCTRL_DOT_CONTEXT: assert always (dot_busy = '1' -> state = S_DOT_WAIT);
  F_BCTRL_MODE_HOLD: assert always (rst = '0' and framed = '1' -> next (framed = '1'));
  F_BCTRL_RESET: assert always (rst = '1' -> next (state = S_IDLE and framed = '0' and not active and not result_valid and loaded(0) = 0 and loaded(1) = 0 and executions = 0 and cached_length = 0));
  F_BCTRL_TX_LAUNCH: assert always (f_seen and tx_start = '1' -> prev(rst = '0' and state = S_SEND and tx_busy = '0') and state = S_SEND_WAIT);
  F_BCTRL_TX_HOLD: assert always (rst = '0' and state = S_SEND_WAIT -> next (tx_data = prev(tx_data)));
  F_BCTRL_COMPARE_CONTEXT: assert always (state = S_COMPARE -> f_duplicate and not cache_response and active);
  F_BCTRL_DUPLICATE_CONTEXT: assert always (f_duplicate -> state = S_COMPARE or state = S_FINISH or state = S_CRC_INIT or state = S_CRC or state = S_ENCODE or state = S_CLOSE or state = S_SEND or state = S_SEND_WAIT or state = S_IDLE);
  F_BCTRL_REPLAY_CONTEXT: assert always (f_replayed -> f_duplicate and (state = S_CRC_INIT or state = S_CRC or state = S_ENCODE or state = S_CLOSE or state = S_SEND or state = S_SEND_WAIT or state = S_IDLE));
  F_BCTRL_OPERATION_CACHE: assert always (state = S_OP or state = S_UPLOAD or state = S_DOT_START or state = S_DOT_WAIT -> cache_response);
  F_BCTRL_COMPARE_PREFIX: assert always (state = S_COMPARE -> (to_integer(f_address) >= scan or watched(q, f_address) = watched(cached_q, f_address)));
  F_BCTRL_NEXT_SEQUENCE: assert always (state = S_OP or state = S_UPLOAD or state = S_DOT_START or state = S_DOT_WAIT -> active and nonce(q) = session and le16(cached_q(6), cached_q(7)) < 65535 and le16(q(6), q(7)) = le16(cached_q(6), cached_q(7))+1);
  F_BCTRL_NO_DUPLICATE_EFFECTS: assert always (f_duplicate -> wr_en = '0' and dot_start = '0' and dot_busy = '0' and step = '0' and dp_rst = '0' and not cache_response);
  F_BCTRL_REPLAY_IDENTITY: assert always (f_replayed -> request_length = cached_length and (to_integer(f_address) >= request_length or watched(q, f_address) = watched(cached_q, f_address)));
  F_BCTRL_REPLAY_RESPONSE: assert always (f_replayed -> body_length = cached_body and (to_integer(f_address) >= body_length or watched(response, f_address) = watched(cached_response, f_address)));
  F_BCTRL_CACHE_HOLD: assert always (f_seen and not f_cache_write -> watched(cached_q, f_address) = f_old_cache and watched(cached_response, f_address) = f_old_response and cached_length = f_old_length and cached_body = f_old_body);
  C_BCTRL_REPLAY: cover {rst = '0' and f_replayed and state = S_CRC_INIT};
  C_BCTRL_CONFLICT: cover {rst = '0' and f_duplicate and state = S_FINISH and response(10) = x"03"};
  C_BCTRL_SELECTED: cover {rst = '0' and framed = '1'};
  C_BCTRL_UPLOAD: cover {rst = '0' and wr_en = '1'};
  C_BCTRL_DOT: cover {rst = '0' and dot_start = '1'};
-- Deterministic reachability-only schedule. These constraints are NEVER
-- loaded into universal proof tasks. case 0 upload, 1 empty DOT, 2 exact
-- replay, 3 same session/sequence with conflicting opcode. CRC bytes generated
-- independently by Python binascii.crc_hqx, initial FFFF.
  signal f_cycle : natural range 0 to 220 := 0;
  signal f_choice : unsigned(1 downto 0);
  attribute anyconst of f_choice : signal is true;
  constant f_hello : bytes_t(0 to 13) := (x"7E", x"01", x"00", x"44", x"33", x"22", x"11", x"00", x"00", x"00", x"00", x"8D", x"E6", x"7E");
  constant f_case_0 : bytes_t(0 to 19) := (x"7E", x"01", x"01", x"44", x"33", x"22", x"11", x"01", x"00", x"06", x"00", x"00", x"00", x"00", x"01", x"07", x"00", x"A6", x"EA", x"7E");
  constant f_case_1 : bytes_t(0 to 15) := (x"7E", x"01", x"02", x"44", x"33", x"22", x"11", x"01", x"00", x"02", x"00", x"00", x"00", x"4A", x"F2", x"7E");
  constant f_case_2 : bytes_t(0 to 13) := (x"7E", x"01", x"00", x"44", x"33", x"22", x"11", x"00", x"00", x"00", x"00", x"8D", x"E6", x"7E");
  constant f_case_3 : bytes_t(0 to 13) := (x"7E", x"01", x"04", x"44", x"33", x"22", x"11", x"00", x"00", x"00", x"00", x"62", x"7A", x"7E");
  function stimulus(cycle, choice : natural) return byte_t is
  begin
    if cycle = 1 then return x"08";
    elsif cycle >= 20 and cycle < 34 then return f_hello(cycle-20);
    else
      case choice is
        when 0 => if cycle >= 150 and cycle < 170 then return f_case_0(cycle-150); end if;
        when 1 => if cycle >= 150 and cycle < 166 then return f_case_1(cycle-150); end if;
        when 2 => if cycle >= 150 and cycle < 164 then return f_case_2(cycle-150); end if;
        when 3 => if cycle >= 150 and cycle < 164 then return f_case_3(cycle-150); end if;
        when others => null;
      end case;
    end if;
    return x"00";
  end function;
  witness_clock : process(clk)
  begin
    if rising_edge(clk) and f_cycle < 220 then f_cycle <= f_cycle+1; end if;
  end process;
  A_BC_WITNESS_RESET: assume always ((rst = '1' and f_cycle = 0) or (rst = '0' and f_cycle /= 0));
  A_BC_WITNESS_TX: assume always (f_seen -> tx_busy = prev(tx_start));
  A_BC_WITNESS_RX: assume always ((rx_valid = '1' and (f_cycle = 1 or (f_cycle >= 20 and f_cycle < 34) or
     (f_choice = 0 and f_cycle >= 150 and f_cycle < 170) or
     (f_choice = 1 and f_cycle >= 150 and f_cycle < 166) or
     (f_choice = 2 and f_cycle >= 150 and f_cycle < 164) or
     (f_choice = 3 and f_cycle >= 150 and f_cycle < 164))) or (rx_valid = '0' and not (f_cycle = 1 or (f_cycle >= 20 and f_cycle < 34) or
     (f_choice = 0 and f_cycle >= 150 and f_cycle < 170) or
     (f_choice = 1 and f_cycle >= 150 and f_cycle < 166) or
     (f_choice = 2 and f_cycle >= 150 and f_cycle < 164) or
     (f_choice = 3 and f_cycle >= 150 and f_cycle < 164))));
  A_BC_WITNESS_DATA: assume always (rx_valid = '1' -> rx_data = stimulus(f_cycle, to_integer(f_choice)));

}
