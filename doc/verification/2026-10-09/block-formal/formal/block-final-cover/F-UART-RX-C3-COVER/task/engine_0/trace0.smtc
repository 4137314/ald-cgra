initial
assume (= [$auto$ghdl.cc:825:import_module$434] #b001)
assume (= [$auto$ghdl.cc:825:import_module$444] #b001)
assume (= [$auto$ghdl.cc:825:import_module$453] #b001)
assume (= [bit_idx] #b000)
assume (= [clk_cnt] #b00)
assume (= [data_r] #b00000000)
assume (= [rx_data] #b10000000)
assume (= [rx_s1] true)
assume (= [rx_s2] true)
assume (= [rx_valid] false)
assume (= [state] #b000)
assume (= [uart_rx_contract.f_seen] false)

state 0
assume (= [clk] false)
assume (= [rst] false)
assume (= [rx_serial] false)

state 1
assume (= [clk] false)
assume (= [rst] false)
assume (= [rx_serial] false)

state 2
assume (= [clk] false)
assume (= [rst] false)
assume (= [rx_serial] true)

state 3
assume (= [clk] false)
assume (= [rst] false)
assume (= [rx_serial] false)

state 4
assume (= [clk] false)
assume (= [rst] false)
assume (= [rx_serial] false)

state 5
assume (= [clk] false)
assume (= [rst] false)
assume (= [rx_serial] false)
