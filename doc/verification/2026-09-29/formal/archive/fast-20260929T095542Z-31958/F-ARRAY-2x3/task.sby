[options]
mode prove
depth 4
timeout 90
[engines]
smtbmc yices
[script]
read_rtlil dut.il
read_verilog -formal  pe_spec.sv array_contract.sv
chparam -set ROWS 2 -set COLS 3 array_contract
prep -top array_contract -flatten
wreduce
opt -full
techmap
opt -full
write_json properties.json
[files]
dut.il
pe_spec.sv
array_contract.sv
